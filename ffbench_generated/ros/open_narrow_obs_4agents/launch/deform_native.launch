<?xml version="1.0" encoding="utf-8"?>
<!-- generated by ffbench: DEFORM in its native Gazebo + TurtleBot3 setup.
     Robots are spawned by DEFORM's own multi_turtlebot3_simulation/one_robot.xml
     (TurtleBot3 + RealSense D435 publishing /tb_<i>/camera/depth/image_raw,
     which DEFORM's drone_detect filters into .../image_filter for grid_map). -->
<launch>
  <arg name="model" default="burger"/>
  <arg name="gui" default="false"/>
  <arg name="world" default="$(dirname)/../worlds/open_narrow_obs.world"/>
  <arg name="episode_timeout_s" default="600"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <node pkg="map_server" type="map_server" name="map_server" args="$(dirname)/../map/open_narrow_obs.yaml"/>

  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_0"/>
    <arg name="robot_x_pos" value="40.8778"/>
    <arg name="robot_y_pos" value="-15.2763"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="-1.6123"/>
  </include>
  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_1"/>
    <arg name="robot_x_pos" value="41.4773"/>
    <arg name="robot_y_pos" value="-15.3012"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="-1.6123"/>
  </include>
  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_2"/>
    <arg name="robot_x_pos" value="42.0767"/>
    <arg name="robot_y_pos" value="-15.3261"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="-1.6123"/>
  </include>
  <include file="$(find multi_turtlebot3_simulation)/launch/one_robot.xml">
    <arg name="model" value="$(arg model)"/>
    <arg name="tb3_name" value="tb_3"/>
    <arg name="robot_x_pos" value="42.6762"/>
    <arg name="robot_y_pos" value="-15.3509"/>
    <arg name="robot_z_pos" value="0.0"/>
    <arg name="robot_yaw" value="-1.6123"/>
  </include>

  <!-- goal: same waypoint every backend uses as the zone exit -->
  <node pkg="f1tenth_deform_bridge" type="goal_publisher.py" name="goal_publisher" output="screen">
    <param name="goal_x" value="41.176262"/>
    <param name="goal_y" value="-34.621677"/>
    <param name="goal_yaw" value="-1.6123"/>
    <param name="tb_num" value="4"/>
    <param name="goal_delay_s" value="10.0"/>
  </node>

  <!-- metrics: ffbench_ros/scripts/metrics_node.py is started next to this
       launch by the ffbench driver (same FullRunMetrics as every backend) -->

  <rosparam param="/tb_0_manager_node/grid_map/obstacles_inflation">0.0</rosparam>
  <rosparam param="/tb_0_manager_node/grid_map/depth_filter_tolerance">0.25</rosparam>
  <include file="$(find plan_manager)/launch/one_run.xml">
    <arg name="tb_id" value="0"/>
    <arg name="tb_num" value="4"/>
    <arg name="frm_type" value="4"/>
    <arg name="other_num_in_opti" value="2"/>
  </include>
  <rosparam param="/tb_1_manager_node/grid_map/obstacles_inflation">0.0</rosparam>
  <rosparam param="/tb_1_manager_node/grid_map/depth_filter_tolerance">0.25</rosparam>
  <include file="$(find plan_manager)/launch/one_run.xml">
    <arg name="tb_id" value="1"/>
    <arg name="tb_num" value="4"/>
    <arg name="frm_type" value="4"/>
    <arg name="other_num_in_opti" value="2"/>
  </include>
  <rosparam param="/tb_2_manager_node/grid_map/obstacles_inflation">0.0</rosparam>
  <rosparam param="/tb_2_manager_node/grid_map/depth_filter_tolerance">0.25</rosparam>
  <include file="$(find plan_manager)/launch/one_run.xml">
    <arg name="tb_id" value="2"/>
    <arg name="tb_num" value="4"/>
    <arg name="frm_type" value="4"/>
    <arg name="other_num_in_opti" value="2"/>
  </include>
  <rosparam param="/tb_3_manager_node/grid_map/obstacles_inflation">0.0</rosparam>
  <rosparam param="/tb_3_manager_node/grid_map/depth_filter_tolerance">0.25</rosparam>
  <include file="$(find plan_manager)/launch/one_run.xml">
    <arg name="tb_id" value="3"/>
    <arg name="tb_num" value="4"/>
    <arg name="frm_type" value="4"/>
    <arg name="other_num_in_opti" value="2"/>
  </include>
</launch>
